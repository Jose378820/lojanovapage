@@ -259,6 +259,7 @@
 .cat-card{
   position:relative;border-radius:var(--radius);overflow:hidden;aspect-ratio:1/1.05;
   cursor:pointer;box-shadow:var(--shadow-sm);transition:transform .35s ease, box-shadow .35s ease;
+  background:var(--verde-bosque-dark);
 }
 .cat-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-md)}
 .cat-card img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
@@ -274,9 +275,9 @@
 .cat-card-label span{font-size:.8rem;color:var(--arena)}
 
 .cat-card-icon{
-  width:100%;height:100%;display:flex;align-items:center;justify-content:center;
+  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
 }
-.cat-card-icon i, .cat-card-icon svg{width:32%;height:32%;color:rgba(255,255,255,.92);stroke-width:1.25}
+.cat-card-icon i, .cat-card-icon svg{width:64px;height:64px;color:rgba(255,255,255,.92);stroke-width:1.25}
 
 /* ---------- Filtros + Catálogo ---------- */
 .catalog{background:var(--blanco)}
